   booktitle = {2020 IEEE Symposium on Visual Languages and Human-Centric Computing (VL/HCC)},
   keywords = {Jupyter,code clones,code duplication,code reuse,computational notebooks,data analysis,data exploration,exploratory programming},
   month = {8},
   publisher = {IEEE Computer Society},
   title = {Code Duplication and Reuse in Jupyter Notebooks},
   volume = {2020-August},
   year = {2020},
}
@article{Kriger2024,
   abstract = {osm_LoD1_3DCityModel village/campus is a Python-based workflow that creates information rich topologically correct Level-of-Detail 1 (LoD1) 3D city models. It addresses challenges in data acquisition and reconstruction by utilizing a raster Digital Terrain Model and volunteered geographic information. The 3D models are in CityJSON format, simulation, and visualization ready.
The workflow targets resource-constrained communities and aims to enable effective communication and decision-making at a grassroots level. Through dynamic visualization and spatial analysis within the Jupyter Notebook environment, the workflow serves as a powerful tool for community-based research, empowering local stakeholders to address pressing challenges and make informed decisions at the neighborhood level. osm_LoD1_3DCityModel village/campus is designed for use in areas with an approximately 2 500 buildings. 
Future work will focus on adding semantic surfaces and Road CityObjects to the 3D model and an additional product; namely a 2.75D surface mesh. Overall, osm_LoD1_3DCityModel village/campus is an efficient and cost-effective solution for generating customized 3D city models, supporting community engagement and citizen science. The workflow is openly available, inviting user engagement to improve its capabilities.},
   author = {Adrian Kriger},
   journal = {South African Journal of Geomatics},
   title = {osm_LoD1_3DCityModel village/campus.  A Free and Open-Source Python-based workflow for the generation of Level-of-Detail 1 3D City Models},
   volume = {13},
   year = {2024},
}
